# Workers Assets headers. Static files are served before the Worker runs,
# so next.config.ts headers() never applies to them.

/images/*
  Cache-Control: public, max-age=31536000, immutable

/cafe-maz/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=604800

/favicon-512.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
