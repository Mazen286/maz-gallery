{
  "name": "maz-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2892",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "preview": "opennextjs-cloudflare build && node scripts/check-build-secrets.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/check-build-secrets.mjs && opennextjs-cloudflare deploy",
    "snap:cafe-card": "tsx scripts/snap-cafe-project-card.ts",
    "playlist-covers": "tsx scripts/playlist-covers.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@tailwindcss/typography": "^0.5.19",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.58.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "world-atlas": "^2.0.2",
    "wrangler": "4.131.0"
  }
