{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maz-gallery",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Enables next/image resizing and AVIF/WebP on Workers. Without this
  // binding OpenNext serves the original file for every /_next/image request.
  // Requires Image Transformations to be enabled on the zone.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
