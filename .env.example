# Café Maz Flavor Lab calls Claude via /api/cafe-maz/flavor-lab.
#
# Do NOT put the key in .env.local: OpenNext compiles every .env* file into the
# deployed Worker (.open-next/cloudflare/next-env.mjs).
#
# Local:      put it in .dev.vars (gitignored)
# Production: wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...
